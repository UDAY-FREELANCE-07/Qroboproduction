# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are unanchored so they apply inside frontend/ and backend/.

# dependencies
node_modules/
.pnp
.pnp.js

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (never commit real values; use .env.example)
.env
.env.*
!.env.example

# keys, certificates, database dumps
*.pem
*.key
*.crt
*.p12
*.pfx
*.dump
*.sql.gz

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/

# local restructure backups
backups/
