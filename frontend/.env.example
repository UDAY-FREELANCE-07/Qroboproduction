# QROBO frontend environment (copy to frontend/.env.local; never commit .env.local)
#
# Only non-secret values belong in this template. NEXT_PUBLIC_* values are inlined into the
# browser bundle, so they must never contain credentials.
# Server-only variables (DATABASE_URL, payment secrets, ...) are documented in
# backend/.env.example. For local PostgreSQL development put them in frontend/.env.local;
# in production inject them from AWS SSM Parameter Store / Secrets Manager (docs/aws-deployment.md).

# Data source: "mock" (default, uses lib/mock-data.ts) or "postgres" (Next.js API + PostgreSQL).
# Build-time AND run-time value; they must match (the server refuses to start otherwise).
DATA_SOURCE=mock

# App
NEXT_PUBLIC_API_URL=http://localhost:3000
