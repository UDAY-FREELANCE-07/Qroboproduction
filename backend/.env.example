# QROBO server-only environment variables — TEMPLATE, placeholders only.
#
# Read only by server code (frontend/lib/server/**, frontend/scripts/db/**). Never prefix any of
# these with NEXT_PUBLIC_. The placeholder values below are deliberately rejected at startup
# (lib/server/config.ts), so a copied template can never be mistaken for real configuration.
#
# Where to put real values:
#   local dev  : frontend/.env.local (gitignored)
#   production : AWS SSM Parameter Store (SecureString) / Secrets Manager -> systemd EnvironmentFile
#                (see docs/aws-deployment.md)

# ---- Data source ----
DATA_SOURCE=postgres                  # mock | postgres  (must match the value used at build time)
NODE_ENV=production

# ---- PostgreSQL (Amazon RDS) : application role, DML only ----
DATABASE_URL=postgresql://qrobo_app:CHANGE_ME@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/qrobo
# TLS: "verify-full" (certificate chain + hostname verified; required in production) or
#      "disable" (local development databases only; refused when NODE_ENV=production).
# Do NOT put sslmode=... in DATABASE_URL; it is rejected.
DATABASE_SSL=verify-full
# Amazon RDS CA bundle (https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem)
DATABASE_SSL_CA_FILE=/etc/qrobo/rds-global-bundle.pem
DATABASE_POOL_MAX=10                  # per app process; see docs/database-architecture.md
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---- PostgreSQL : migration role (used only by `npm run db:migrate` / `db:seed`) ----
MIGRATION_DATABASE_URL=postgresql://qrobo_migrator:CHANGE_ME@your-rds-endpoint.ap-south-1.rds.amazonaws.com:5432/qrobo

# ---- HTTP ----
# Extra allowed browser origins for state-changing API calls (comma-separated). The request's
# own Host is always allowed; set this to the public site origin when behind a proxy/CDN.
APP_ORIGINS=https://your-domain.example

# ---- Razorpay (online payment NOT implemented yet; only webhook verification exists) ----
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ---- Admin bootstrap ----
# Comma-separated. Each address becomes an admin automatically AFTER its owner registers and
# clicks the email verification link (owning the inbox is the proof). Example: owner@your-domain.example
ADMIN_EMAILS=owner@your-domain.example

# ---- Email (docs/email.md) ----
APP_URL=https://your-domain.example   # base for links in emails; must be https in production
EMAIL_PROVIDER=log                    # log (prints to server log, sends nothing) | smtp | resend
EMAIL_FROM="Qrobo <no-reply@your-domain.example>"
# smtp (e.g. Gmail: smtp.gmail.com, 465, your Gmail address, a 16-character App Password)
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=465
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
# resend
RESEND_API_KEY=your-resend-api-key

# ---- Not integrated (reserved names) ----
AWS_REGION=ap-south-1                 # prefer the EC2 instance IAM role over access keys
REDIS_URL=redis://localhost:6379

